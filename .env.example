# ---- LitigationOS configuration (copy to .env and fill in) ----

# PostgreSQL
POSTGRES_USER=litigation
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=litigation

# Object storage (S3-compatible — SeaweedFS; anonymous in dev)
S3_BUCKET=litigation-evidence
S3_SECRET_KEY=change-me-now

# Backend
# Secret used to sign JWTs — set a long random value in .env
JWT_SECRET=dev-secret-change-me

# First-run owner account (created once at first backend start)
OWNER_EMAIL=owner@localhost.dev
OWNER_PASSWORD=change-me-now
# Comma-separated list of allowed CORS origins (frontend)
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# OCR languages (Tesseract codes, '+'-separated)
OCR_LANGS=nld+fra+rus

# n8n (http://localhost:5678)
N8N_USER=admin
N8N_PASSWORD=change-me-now

# Webhook token for n8n → backend integration
WEBHOOK_TOKEN=dev-webhook-token

# LLM provider
LLM_PROVIDER=anthropic        # anthropic | openai | google
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
