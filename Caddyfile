# Serves:
#  - http://localhost:80   (local smoke; no ACME possible for "localhost")
#  - https://{$DOMAIN}     (real domain in prod when DOMAIN is a public hostname)
#
# When DOMAIN=localhost, the https site block expands to https://localhost
# which is what the environment intends for local verification anyway.

http://localhost {
  handle /api/* {
    reverse_proxy backend:8000
  }
  handle /health {
    reverse_proxy backend:8000
  }
  handle {
    reverse_proxy frontend:3000
  }
}

https://{$DOMAIN} {
  handle /api/* {
    reverse_proxy backend:8000
  }
  handle /health {
    reverse_proxy backend:8000
  }
  handle {
    reverse_proxy frontend:3000
  }
}
